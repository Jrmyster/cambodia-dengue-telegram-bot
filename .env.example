# Telegram Bot API token obtained from @BotFather
TELEGRAM_BOT_TOKEN=replace_with_BotFather_token
# Application environment (development or production)
NODE_ENV=development
# Telegram transport: polling for local use, webhook for cloud hosting
BOT_MODE=polling
# Express listens in both modes; cloud hosts can supply PORT
PORT=3000
DATABASE_PATH=./data/bot.sqlite
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_KEY_SECRET=replace_with_at_least_32_random_characters
# Webhook mode only: public HTTPS origin, no trailing path.
PUBLIC_URL=https://your-service.example.com
# Generate a DIFFERENT random secret; Telegram permits A-Z a-z 0-9 _ -.
WEBHOOK_SECRET=replace_with_a_different_random_secret
SESSION_TTL_MINUTES=30
